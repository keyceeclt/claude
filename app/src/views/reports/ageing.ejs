<%- include('../partials/header') %>
<%- include('nav') %>
<% if (me.data_scope === 'ALL') { %>
<form method="get" class="filters"><label>Branch <select name="branch"><option value="">All</option>
  <% L.branches.forEach(b => { %><option value="<%= b.branch_id %>" <%= String(branch) === String(b.branch_id) ? 'selected' : '' %>><%= b.name %></option><% }) %></select></label>
  <button class="btn secondary">Show</button></form>
<% } %>
<div class="card"><h2>Open leads by age</h2>
<% if (!rows.length) { %><div class="empty">No open leads.</div><% } else { %>
<div class="table-wrap"><table>
  <thead><tr><th>Age</th><th class="num">Open leads</th><th class="num">Stated budget ₹</th><th class="num">Not contacted</th><th class="num">FU overdue</th><th class="num">No next FU</th><th class="num">Stale</th></tr></thead>
  <tbody><% rows.forEach(r => { %><tr><td><%= r.age_bucket %></td><td class="num"><%= r.open_leads %></td><td class="num"><%= fmtMoney(r.stated_budget_value) %></td>
    <td class="num"><%= r.not_contacted_within_sla %></td><td class="num"><%= r.followup_overdue %></td><td class="num"><%= r.no_next_followup %></td><td class="num"><%= r.stale %></td></tr><% }) %></tbody>
</table></div><% } %>
<p class="small muted">Stated budget is what customers mentioned, not a forecast.</p>
</div>
<div class="card"><h2>Who needs to act</h2>
<% if (!byOwner.length) { %><div class="empty">Nothing pending.</div><% } else { %>
<div class="table-wrap"><table><thead><tr><th>Staff</th><th>Branch</th><th class="num">Open leads</th><th class="num">Needing action</th></tr></thead><tbody>
<% byOwner.forEach(r => { %><tr><td><%= L.employee[r.assigned_to]?.employee_name || 'Unassigned' %></td><td><%= L.branch[r.branch_id]?.name %></td>
  <td class="num"><%= r.open_leads %></td><td class="num"><a href="/leads?attention=any<%= r.assigned_to ? '&owner=' + encodeURIComponent(r.assigned_to) : '' %>"><%= r.needing_action %></a></td></tr><% }) %>
</tbody></table></div><% } %>
</div>
<%- include('../partials/footer') %>
