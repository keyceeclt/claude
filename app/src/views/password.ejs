<%- include('partials/header') %>
<div class="login card">
  <h1>Change password</h1>
  <% if (me && me.must_change_password) { %><p class="muted">Set your own password before you continue.</p><% } %>
  <% if (error) { %><div class="flash bad"><%= error %></div><% } %>
  <form method="post" action="/account/password" class="stack">
    <%- include('partials/csrf') %>
    <label>Current password <input type="password" name="current" autocomplete="current-password" required></label>
    <label>New password (10+ characters) <input type="password" name="password" autocomplete="new-password" minlength="10" required></label>
    <label>Repeat new password <input type="password" name="confirm" autocomplete="new-password" minlength="10" required></label>
    <button class="btn">Save password</button>
  </form>
</div>
<%- include('partials/footer') %>
