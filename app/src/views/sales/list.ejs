<%- include('../partials/header') %>
<div class="page-head"><h1>Sales</h1><% if (me.data_scope !== 'OWN') { %><a class="btn" href="/sales/new">+ Record sale</a><% } %></div>
<form method="get" class="filters card">
  <label>From <input type="date" name="from" value="<%= from %>"></label>
  <label>To <input type="date" name="to" value="<%= to %>"></label>
  <% if (me.data_scope === 'ALL') { %><label>Branch <select name="branch"><option value="">All</option>
    <% L.branches.forEach(b => { %><option value="<%= b.branch_id %>" <%= String(branch) === String(b.branch_id) ? 'selected' : '' %>><%= b.name %></option><% }) %></select></label><% } %>
  <button class="btn">Show</button>
</form>
<% const total = rows.reduce((a, s) => a + s.net_value, 0), fromLeads = rows.filter(s => s.lead_id).reduce((a, s) => a + s.net_value, 0); %>
<div class="tiles">
  <div class="tile"><div class="k">Sales</div><div class="v"><%= fmtMoney(total) %></div><div class="small muted"><%= rows.length %> invoices</div></div>
  <div class="tile"><div class="k">From CRM leads</div><div class="v"><%= fmtMoney(fromLeads) %></div><div class="small muted"><%= fmtPct(total ? 100 * fromLeads / total : null) %> of sales</div></div>
  <div class="tile"><div class="k">Walk-in / direct</div><div class="v"><%= fmtMoney(total - fromLeads) %></div></div>
</div>
<div class="card">
<% if (!rows.length) { %><div class="empty">No sales in this period.</div><% } else { %>
<div class="table-wrap"><table>
  <thead><tr><th>Date</th><th>Invoice</th><th>Customer</th><th class="hide-sm">Branch</th><th class="hide-sm">Sold by</th><th>Lead</th><th class="num">Value</th></tr></thead>
  <tbody><% rows.forEach(s => { %><tr>
    <td class="nowrap"><%= fmtDate(s.invoice_date) %></td><td><%= s.invoice_no %></td>
    <td><% if (s.customer_id) { %><a href="/customers/<%= s.customer_id %>"><%= s.customer_name || s.mobile %></a><% } else { %><span class="muted">Counter sale</span><% } %></td>
    <td class="hide-sm"><%= L.branch[s.branch_id]?.name %></td><td class="hide-sm"><%= L.employee[s.sold_by]?.employee_name || '—' %></td>
    <td><% if (s.lead_id) { %><a href="/leads/<%= s.lead_id %>">#<%= s.lead_id %></a><% } else { %><span class="pill muted">walk-in</span><% } %></td>
    <td class="num"><%= fmtMoney(s.net_value) %></td></tr><% }) %></tbody></table></div>
<% } %>
</div>
<%- include('../partials/footer') %>
